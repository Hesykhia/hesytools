{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hesytools",
  "version": "0.1.0",
  "identifier": "com.hesy.hesytools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hesytools",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0e0f13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}