{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hesytools",
  "version": "5.0.0",
  "identifier": "com.hesy.hesytools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hesytools",
        "width": 1000,
        "height": 700,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#08080c",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "hesy",
    "shortDescription": "Macros, autoclicker and screen watching",
    "longDescription": "hesytools: record and replay macros, autoclick keys and mouse buttons, and react to what's on screen with OCR.",
    "copyright": "hesy",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "hesytools"
}